# Copy this file to .env. Demo mode starts the UI without external credentials.
# Demo replies are placeholders and do not query live services.
Agent_llm=DEMO

# To enable the live agent, select OPENAI, DEEPSEEK, or OLLAMA and configure
# the matching credentials/service below. Also configure Pinecone for SOP search.
# Agent_llm=OPENAI
# OPENAI_API_KEY=
# Agent_llm=DEEPSEEK
# DEEPSEEK_API_KEY=
# Agent_llm=OLLAMA
# Ollama must be running locally with the qwen2.5:7b model available.

PINECONE_API_KEY=
Embeddings_model=LOCAL
Local_Embedding_Model=BAAI/bge-m3

SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_AGENT_USER=USR_FDE_RO
SQL_AGENT_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
